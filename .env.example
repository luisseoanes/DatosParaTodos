# ============================================================
# DatosParaTodos — Variables de entorno del backend
# Copia este archivo como .env y rellena los valores reales
# NUNCA subas .env a git
# ============================================================

# API Key de Google Gemini (obligatoria)
# Obtener en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Modelo de Gemini a usar (por defecto el más ligero)
GEMINI_MODEL=gemini-2.5-flash-lite-preview-06-17

# TTL de sesiones de chat en minutos (por defecto 120)
SESSION_TTL_MINUTES=120
